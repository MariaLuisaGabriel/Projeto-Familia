{
  "name": "estudos",
  "version": "0.2.0",
  "private": true,
  "description": "Plataforma de estudos modular orientada a metadados e templates",
  "type": "module",
  "workspaces": [
    "apps/*",
    "modules/*",
    "packages/*",
    "tools/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@estudos/web",
    "dev:api": "node --import ./tools/link-workspaces.mjs apps/api/src/server.ts",
    "dev:worker": "node --import ./tools/link-workspaces.mjs apps/worker/src/worker.ts",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "tsc --build",
    "test": "node --import ./tools/link-workspaces.mjs --test packages/core/src/core.test.ts packages/registries/src/registries.test.ts packages/template-schema/src/template-schema.test.ts modules/modules.test.ts tools/fitness/fitness.test.ts",
    "check:arch": "node --import ./tools/link-workspaces.mjs tools/fitness/check-architecture.ts",
    "gen": "node tools/generators/cli.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.5"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
